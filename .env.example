# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by ingest routes to write.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Ingest authentication
# ---------------------------------------------------------------------------
# Shared secret pg_cron sends as the x-ingest-secret header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# Shared secret the form capture webhook sends as x-capture-secret.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTURE_WEBHOOK_SECRET=

# Shared secret for POST /api/webhooks/rb2b.
# Send it as the x-rb2b-secret header, or as ?secret= when the sender cannot
# set headers. RB2B's webhook destination is a URL only, so use the query form
# there. Do not log that URL: the query value is the secret.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RB2B_WEBHOOK_SECRET=replace-with-a-random-secret

# ---------------------------------------------------------------------------
# Google (GA4 Data API + Search Console) — one service account for both.
# Grant it Viewer on each GA4 property and add it as a user on each
# Search Console property. PRIVATE_KEY keeps its literal \n escapes.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Microsoft Clarity — Project Settings > Data Export > generate API token.
# One token per project. Each project has its own 10 request per day cap.
# brandmultiplier.ai (k0r7x8mkc7) uses CLARITY_API_TOKEN.
# chrisrubincreativ.com (yv4cy3vjqc) uses CLARITY_API_TOKEN_CRC.
# chrisrubin.com (zc0y67nz88) uses CLARITY_API_TOKEN_CHRISRUBIN.
# A project with no token is skipped and named on the Clarity panel.
# ---------------------------------------------------------------------------
CLARITY_API_TOKEN=
CLARITY_API_TOKEN_CRC=
CLARITY_API_TOKEN_CHRISRUBIN=

# ---------------------------------------------------------------------------
# Calendly — personal access token from Integrations > API & Webhooks.
# ---------------------------------------------------------------------------
CALENDLY_API_TOKEN=
