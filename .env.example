# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by ingest routes to write.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Ingest authentication
# ---------------------------------------------------------------------------
# Shared secret pg_cron sends as the x-ingest-secret header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SECRET=

# Shared secret the form capture webhook sends as x-capture-secret.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTURE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google (GA4 Data API + Search Console) — one service account for both.
# Grant it Viewer on each GA4 property and add it as a user on each
# Search Console property. PRIVATE_KEY keeps its literal \n escapes.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Microsoft Clarity — Project Settings > Data Export > generate API token.
# The token is scoped to a single project, so a shared project needs one token.
# ---------------------------------------------------------------------------
CLARITY_API_TOKEN=

# ---------------------------------------------------------------------------
# Calendly — personal access token from Integrations > API & Webhooks.
# ---------------------------------------------------------------------------
CALENDLY_API_TOKEN=
